name: FundLensMobile
options:
  bundleIdPrefix: com.personal
settings:
  base:
    SWIFT_VERSION: '5.0'
    IPHONEOS_DEPLOYMENT_TARGET: '17.0'
    TARGETED_DEVICE_FAMILY: '1'
    DEVELOPMENT_TEAM: ''
targets:
  FundLensMobile:
    type: application
    platform: iOS
    sources:
      - path: Sources
      - path: Assets.xcassets
    info:
      path: Info.plist
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.personal.fundlens.iphone18pro
        PRODUCT_NAME: FundLensMobile
        CODE_SIGNING_ALLOWED: NO
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        INFOPLIST_KEY_UIApplicationSupportsDocumentBrowser: NO
        SUPPORTS_MACCATALYST: NO
    scheme:
      testTargets: []
